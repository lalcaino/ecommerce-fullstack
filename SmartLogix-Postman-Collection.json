{
  "info": {
    "name": "SmartLogix - API Ecommerce Fullstack",
    "description": "Colección de Postman para la API REST de SmartLogix.\n\nArquitectura:\n- BFF (API Gateway): http://localhost:8000/api/\n- ms-inventario: http://localhost:8001/api/\n- ms-pedidos: http://localhost:8002/api/\n- ms-envios: http://localhost:8003/api/\n\nAutenticación: JWT (Bearer token)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Registro Empresa",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/registro/", "host": ["{{base_url}}"], "path": ["api", "auth", "registro"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rut\": \"76.123.456-7\",\n  \"razon_social\": \"Mi Empresa SpA\",\n  \"nombre_comercial\": \"MiEmpresa\",\n  \"giro\": \"Venta al por menor\",\n  \"giro_codigo\": \"471100\",\n  \"region\": \"Metropolitana\",\n  \"email\": \"admin@miempresa.cl\",\n  \"password\": \"Admin123!\",\n  \"nombre_representante\": \"Juan Pérez\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/login/", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@miempresa.cl\",\n  \"password\": \"Admin123!\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/refresh/", "host": ["{{base_url}}"], "path": ["api", "auth", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"<refresh_token>\"\n}"
            }
          }
        },
        {
          "name": "Perfil Usuario",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/auth/perfil/", "host": ["{{base_url}}"], "path": ["api", "auth", "perfil"] }
          }
        }
      ]
    },
